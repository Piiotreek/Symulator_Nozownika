@section Scripts {
    <script>
        // Po zakończeniu gry
        async function saveGameResults(kills, deaths, score, playTime, won) {
            const response = await fetch('/Statistics/UpdateStatistics', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    kills: kills,
                    deaths: deaths,
                    score: score,
                    playTime: playTime,
                    points: calculatePoints(score, won),
                    won: won
                })
            });

            return await response.json();
        }

        function calculatePoints(score, won) {
            // Twoja logika obliczania punktów
            return won ? score * 2 : score;
        }
    </script>
}