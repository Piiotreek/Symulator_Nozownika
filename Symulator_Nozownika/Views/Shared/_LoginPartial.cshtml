@if(Context.User.Identity.Name != null)
{
    <li class="nav-item login-center">
        <a class="nav-link text-dark fw-bold">Hello @Context.User.Identity.Name</a>
    </li>
}
else
{
    <li class="nav-item please-center">
        <a class= "text-dark fw-bold">Please log into the Account</a>
    </li>
}