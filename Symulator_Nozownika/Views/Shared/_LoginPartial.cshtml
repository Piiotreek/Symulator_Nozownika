@if(Context.User.Identity.Name !=null){
   <form asp-area="" asp-controller="AccountController1" asp-action="Logout" method="post" id="logoutForm" class="navbar-right">
        <ul>
            <li><a>Hello @Context.User.Identity.Name</a></li>
            <li><button type="submit" class="btn btn-link navbar-btn navbar-link">Logout</button></li>
        </ul>
    </form>
}
else
{
    <ul>
        <li><a asp-area="" asp-controller="AccountController1" asp-action="Login">Login</a></li>
        <li><a asp-area="" asp-controller="AccountController1" asp-action="Registration">Register</a></li>
    </ul>
}