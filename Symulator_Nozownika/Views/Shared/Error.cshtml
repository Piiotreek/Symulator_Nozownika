@model ErrorViewModel
@{
    ViewData["Title"] = "Błąd";
}

<h1 class="text-danger">Błąd.</h1>
<h2 class="text-danger">Wystąpił błąd podczas przetwarzania żądania.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identyfikator żądania:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Tryb deweloperski</h3>
<p>
    Przełączenie środowiska na <strong>Development</strong> wyświetli więcej szczegółów o błędzie.
</p>
<p>
    <strong>Środowisko Development nie powinno być włączone na wdrożonej aplikacji.</strong>
    Może to ujawnić użytkownikom końcowym wrażliwe informacje z wyjątków.
    Do lokalnego debugowania ustaw zmienną środowiskową <strong>ASPNETCORE_ENVIRONMENT</strong> na <strong>Development</strong>
    i uruchom aplikację ponownie.
</p>
