<div id="toast-container" class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3 mb-4" style="z-index: 1055;"></div>

<script>
    function showAchievementToast(achievementName, imagePath) {
        const toastContainer = document.getElementById('toast-container');
        if (!toastContainer) return;

        const toastId = 'toast-' + Date.now();

        // 10s 
        const toastHtml = `
            <div id="${toastId}" class="toast align-items-center text-bg-dark border-warning shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="10000">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center p-3">
                        <img src="${imagePath}" alt="Ikona" style="height: 50px; width: 50px; object-fit: contain; margin-right: 15px;" />
                        <div>
                            <strong class="text-white d-block" style="font-size: 0.85rem;">🏆 Odblokowano Osiągnięcie!</strong>
                            <span class="text-warning fw-bold" style="font-size: 1.1rem;">${achievementName}</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-3 m-auto" data-bs-dismiss="toast" aria-label="Zamknij"></button>
                </div>
            </div>
        `;

        toastContainer.insertAdjacentHTML('beforeend', toastHtml);

        const toastElement = document.getElementById(toastId);
        const toast = new bootstrap.Toast(toastElement);
        toast.show();

        // delate
        toastElement.addEventListener('hidden.bs.toast', () => {
            toastElement.remove();
            console.log(`Toast for achievement "${achievementName}" removed from DOM.`);
        });
    }
</script>
