<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Symulator_Nozownika</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico?v=2" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/darkly/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Symulator_Nozownika.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid position-relative">
                
                <!-- Hello User - wyśrodkowane na desktop -->
                <div class="position-absolute top-50 start-50 translate-middle d-none d-sm-block">
                    @await Html.PartialAsync("_LoginPartial")
                </div>
                
                <!-- Hello User - obok logo na mobile -->
                <span class="d-sm-none text-dark fw-bold ms-2 mobile-hello">
                    @await Html.PartialAsync("_LoginPartial")
                </span>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse bg-white">
                    <!-- Lewa sekcja -->
                    <ul class="navbar-nav">
                        @{
                            var isDemoUser = Context.User.FindFirst("IsDemo")?.Value == "true";
                        }
                        @if (!isDemoUser)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="GameScore" asp-action="Highscores">🏆 Ranking</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Quest" asp-action="Index">📋 Questy</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Club" asp-action="Index">🏢 Kluby</a>
                            </li>
                        }

                    <!-- Prawa sekcja -->
                    <ul class="navbar-nav ms-auto">
                        @await Html.PartialAsync("_DemoUserMenu")
                        @await Html.PartialAsync("_LoginButtons")
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">👤 Konto</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Statistics" asp-action="Index">📊 Statystyki</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Symulator_Nozownika
        </div>
    </footer>
    <div id="toast-container" class="toast-container position-fixed top-0 start-50 translate-middle-x p-3 mt-2" style="z-index: 1055;"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="~/js/highscore.js"></script>
    @RenderSection("Scripts", required: false)
    @* div for toasts *@
    
</body>
</html>
