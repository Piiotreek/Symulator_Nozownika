@model Symulator_Nozownika.Models.UserAccount

@{
    ViewData["Title"] = "Moje Konto";
}

<div class="container">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">👤 Moje Konto</h2>
                </div>
                <div class="card-body">
                    @{
                        var avatarSrc = string.IsNullOrEmpty(Model.AvatarPath) ? "/images/default-avatar.svg" : Model.AvatarPath;
                    }

                    <!-- Główny wiersz: awatar | info | statystyki -->
                    <div class="d-flex gap-4 mb-4 align-items-start">

                        <!-- Awatar (stała szerokość, nie rozciąga layoutu) -->
                        <div class="text-center flex-shrink-0" style="width:130px;">
                            <img src="@avatarSrc" alt="Awatar" class="rounded-circle mb-2"
                                 style="width:110px;height:110px;object-fit:cover;border:3px solid #0d6efd;" />
                            <div>
                                <button class="btn btn-outline-primary btn-sm w-100"
                                        data-bs-toggle="collapse" data-bs-target="#avatarUploadForm">
                                    🖼️ Zmień awatar
                                </button>
                            </div>
                        </div>

                        <!-- Informacje o koncie -->
                        <div class="flex-shrink-0">
                            <h5 class="mb-3">Informacje o koncie</h5>
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-muted fw-semibold pe-3" style="white-space:nowrap;">Nazwa użytkownika</td>
                                        <td><strong>@Model.UserName</strong></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted fw-semibold pe-3" style="white-space:nowrap;">Email</td>
                                        <td>@Model.Email</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted fw-semibold pe-3" style="white-space:nowrap;">Data utworzenia</td>
                                        <td>@Model.CreatedAt.ToString("dd.MM.yyyy")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Statystyki -->
                        <div class="flex-grow-1">
                            @if (Model.Statistics != null)
                            {
                                <h5 class="mb-3">Szybki przegląd statystyk</h5>
                                <div class="alert alert-info mb-0" style="max-width:260px;">
                                    <p class="mb-1">🎮 Gry: <strong>@Model.Statistics.TotalGamesPlayed</strong></p>
                                    <p class="mb-1">🏆 Najwyższy wynik: <strong>@Model.Statistics.HighestScore</strong></p>
                                    <p class="mb-0">📊 Łączny wynik: <strong>@Model.Statistics.TotalScore</strong></p>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">Brak statystyk – zacznij grać!</p>
                            }
                        </div>
                    </div>

                    <!-- Formularz awatara POZA głównym wierszem — nie wpływa na layout -->
                    <div class="collapse mb-3" id="avatarUploadForm">
                        <div class="card card-body p-3" style="max-width:320px;">
                            <form asp-controller="Account" asp-action="UploadAvatar" asp-route-returnUrl="account"
                                  method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="file" name="avatarFile" accept=".jpg,.jpeg,.png,.gif"
                                       class="form-control form-control-sm mb-1" />
                                <small class="text-muted d-block mb-2">jpg/png/gif, max 2 MB</small>
                                <button type="submit" class="btn btn-primary btn-sm w-100">Zapisz awatar</button>
                            </form>
                        </div>
                    </div>

                    @if (TempData["AvatarError"] != null)
                    {
                        <div class="alert alert-danger p-2 small mb-3">@TempData["AvatarError"]</div>
                    }
                    @if (TempData["AvatarSuccess"] != null)
                    {
                        <div class="alert alert-success p-2 small mb-3">@TempData["AvatarSuccess"]</div>
                    }

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a asp-controller="Statistics" asp-action="Index" class="btn btn-primary btn-lg">
                            📊 Zobacz Pełne Statystyki
                        </a>
                        <a asp-controller="Statistics" asp-action="Leaderboard" class="btn btn-warning btn-lg">
                            🏆 Ranking
                        </a>
                        <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-secondary">
                            🔒 Zmień Hasło
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>