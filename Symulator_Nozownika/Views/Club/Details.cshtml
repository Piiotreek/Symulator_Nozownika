@model ClubDetailsViewModel

@{
    ViewData["Title"] = "Club Details";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-lg mb-4">
                <div class="card-header bg-primary text-white">
                    <h1 class="mb-0">@Model.Name</h1>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="lead">@Model.Description</p>
                    }

                    <hr />

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5>Club Information</h5>
                            <ul class="list-unstyled">
                                <li><strong>Owner:</strong> @Model.OwnerName</li>
                                <li><strong>Created:</strong> @Model.CreatedAt.ToString("MMMM dd, yyyy")</li>
                                <li><strong>Members:</strong> @Model.MemberCount / @Model.MaxMembers</li>
                                <li><strong>Available Spots:</strong> 
                                    <span class="badge bg-info">@Model.AvailableSpots</span>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h5>Club Status</h5>
                            <div class="progress mb-3">
                                <div class="progress-bar" role="progressbar" 
                                     style="width: @((Model.MemberCount * 100) / Model.MaxMembers)%"
                                     aria-valuenow="@Model.MemberCount" 
                                     aria-valuemin="0" 
                                     aria-valuemax="@Model.MaxMembers">
                                    @Model.MemberCount / @Model.MaxMembers
                                </div>
                            </div>
                            @if (Model.IsFull)
                            {
                                <div class="alert alert-warning mb-0">
                                    <i class="fas fa-exclamation-triangle"></i> This club is full
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success mb-0">
                                    <i class="fas fa-check-circle"></i> @Model.AvailableSpots spots available
                                </div>
                            }
                        </div>
                    </div>

                    <hr />

                    <h5>Members (@Model.MemberCount)</h5>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Username</th>
                                    <th>Country</th>
                                    <th>Role</th>
                                    @if (Model.IsOwner)
                                    {
                                        <th>Actions</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in Model.Members)
                                {
                                    <tr>
                                        <td>@member.FullName</td>
                                        <td>
                                            <a href="@Url.Action("ViewProfile", "Account", new { id = member.UserId })"
                                               class="text-decoration-none text-primary">
                                                @member.UserName
                                            </a>
                                        </td>
                                        <td>@member.Country</td>
                                        <td>
                                            @if (member.Id == Model.OwnerId)
                                            {
                                                <span class="badge bg-primary">Owner</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Member</span>
                                            }
                                        </td>
                                        @if (Model.IsOwner && member.Id != Model.OwnerId)
                                        {
                                            <td>
                                                <form method="post" action="@Url.Action("RemoveMember", "Club")" 
                                                      style="display: inline;">
                                                    <input type="hidden" name="clubId" value="@Model.Id" />
                                                    <input type="hidden" name="memberId" value="@member.Id" />
                                                    <button type="submit" class="btn btn-sm btn-danger" 
                                                            onclick="return confirm('Remove this member?');">
                                                        <i class="fas fa-trash"></i> Remove
                                                    </button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-lg">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    <a asp-controller="Report" asp-action="ClubCsv" asp-route-id="@Model.Id" class="btn btn-outline-info w-100 mb-2">📥 Eksportuj listę członków (CSV)</a>
                    @if (Model.IsMember)
                    {
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle"></i> You are a member of this club
                        </div>

                        <a href="@Url.Action("Chat", "Club", new { clubId = Model.Id })" class="btn btn-info w-100 mb-2">
                            <i class="fas fa-comments"></i> Club Chat
                        </a>

                        @if (!Model.IsOwner)
                        {
                            <form method="post" action="@Url.Action("LeaveClub", "Club")">
                                <input type="hidden" name="clubId" value="@Model.Id" />
                                <button type="submit" class="btn btn-danger w-100" 
                                        onclick="return confirm('Are you sure you want to leave this club?');">
                                    <i class="fas fa-sign-out-alt"></i> Leave Club
                                </button>
                            </form>
                        }
                        else
                        {
                            <form method="post" action="@Url.Action("DeleteClub", "Club")" class="mt-3">
                                <input type="hidden" name="clubId" value="@Model.Id" />
                                <button type="submit" class="btn btn-danger w-100" 
                                        onclick="return confirm('This will permanently delete the club. Are you sure?');">
                                    <i class="fas fa-trash"></i> Delete Club
                                </button>
                            </form>
                        }
                    }
                    else if (!Model.IsFull)
                    {
                        <form method="post" action="@Url.Action("JoinClub", "Club")">
                            <input type="hidden" name="clubId" value="@Model.Id" />
                            <button type="submit" class="btn btn-success w-100">
                                <i class="fas fa-plus"></i> Join This Club
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-circle"></i> This club is full and cannot accept new members
                        </div>
                    }

                    <a href="@Url.Action("Index", "Club")" class="btn btn-outline-secondary w-100 mt-2">
                        <i class="fas fa-arrow-left"></i> Back to Clubs
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            alert('@TempData["Success"]');
        });
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            alert('Error: @TempData["Error"]');
        });
    </script>
}
