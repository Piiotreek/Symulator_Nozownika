@model CreateClubViewModel

@{
    ViewData["Title"] = "Create Club";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-plus-circle"></i> Create New Club
                    </h3>
                </div>
                <div class="card-body">
                    <form method="post" action="@Url.Action("Create", "Club")">
                        <div class="mb-3">
                            <label for="Name" class="form-label">Club Name *</label>
                            <input type="text" 
                                   class="form-control" 
                                   id="Name" 
                                   name="Name" 
                                   placeholder="Enter club name"
                                   required>
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <span asp-validation-for="Name" class="text-danger"></span>
                            <small class="form-text text-muted">3-100 characters</small>
                        </div>

                        <div class="mb-3">
                            <label for="Description" class="form-label">Club Description</label>
                            <textarea class="form-control" 
                                      id="Description" 
                                      name="Description" 
                                      rows="4" 
                                      placeholder="Describe your club..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                            <small class="form-text text-muted">Max 500 characters</small>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            <strong>Note:</strong> You will become the club owner. Maximum 20 members allowed.
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save"></i> Create Club
                            </button>
                            <a href="@Url.Action("Index", "Club")" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
    }

    .form-label {
        font-weight: 500;
        color: #333;
    }

    textarea.form-control {
        resize: vertical;
    }
</style>
