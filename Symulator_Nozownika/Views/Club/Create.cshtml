@model CreateClubViewModel

@{
    ViewData["Title"] = "Załóż klub";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-plus-circle"></i> Załóż nowy klub
                    </h3>
                </div>
                <div class="card-body">
                    <form method="post" action="@Url.Action("Create", "Club")">
                        <div class="mb-3">
                            <label for="Name" class="form-label">Nazwa klubu *</label>
                            <input type="text" 
                                   class="form-control" 
                                   id="Name" 
                                   name="Name" 
                                   placeholder="Wpisz nazwę klubu"
                                   required>
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <span asp-validation-for="Name" class="text-danger"></span>
                            <small class="form-text text-muted">Od 3 do 100 znaków</small>
                        </div>

                        <div class="mb-3">
                            <label for="Description" class="form-label">Opis klubu</label>
                            <textarea class="form-control" 
                                      id="Description" 
                                      name="Description" 
                                      rows="4" 
                                      placeholder="Opisz swój klub..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                            <small class="form-text text-muted">Maksymalnie 500 znaków</small>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            <strong>Uwaga:</strong> Zostaniesz właścicielem klubu. Maksymalnie 20 członków.
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save"></i> Załóż klub
                            </button>
                            <a href="@Url.Action("Index", "Club")" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> Anuluj
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
    }

    .form-label {
        font-weight: 500;
        color: #333;
    }

    textarea.form-control {
        resize: vertical;
    }
</style>
