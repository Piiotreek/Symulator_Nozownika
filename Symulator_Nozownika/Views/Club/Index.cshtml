@model List<ClubListViewModel>

@{
    ViewData["Title"] = "Clubs";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>🏛️ Clubs</h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Create", "Club")" class="btn btn-primary">
                <i class="fas fa-plus"></i> Create New Club
            </a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No clubs found. Be the first to create one!
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var club in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">@club.Name</h5>
                        </div>
                        <div class="card-body">
                            <p class="card-text text-muted">
                                <small>Founded by <strong>@club.OwnerName</strong></small>
                            </p>
                            
                            @if (!string.IsNullOrEmpty(club.Description))
                            {
                                <p class="card-text">@club.Description</p>
                            }

                            <div class="mb-3">
                                <small class="text-muted">
                                    <i class="fas fa-users"></i> 
                                    Members: <strong>@club.MemberCount/@club.MaxMembers</strong>
                                </small>
                            </div>

                            <div class="progress mb-3">
                                <div class="progress-bar" role="progressbar" 
                                     style="width: @((club.MemberCount * 100) / club.MaxMembers)%"
                                     aria-valuenow="@club.MemberCount" 
                                     aria-valuemin="0" 
                                     aria-valuemax="@club.MaxMembers">
                                </div>
                            </div>

                            <p class="card-text">
                                <small>
                                    <i class="fas fa-chair"></i>
                                    Available spots: <strong>@club.AvailableSpots</strong>
                                    @if (club.IsFull)
                                    {
                                        <span class="badge bg-danger">Full</span>
                                    }
                                </small>
                            </p>

                            <small class="text-muted">
                                Created: <strong>@club.CreatedAt.ToString("yyyy-MM-dd")</strong>
                            </small>
                        </div>
                        <div class="card-footer bg-light">
                            <div class="btn-group w-100" role="group">
                                <a href="@Url.Action("Details", "Club", new { id = club.Id })" 
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i> View
                                </a>
                                
                                @if (club.IsMember)
                                {
                                    <span class="btn btn-sm btn-outline-success disabled">
                                        <i class="fas fa-check"></i> Member
                                    </span>
                                }
                                else if (!club.IsFull)
                                {
                                    <form method="post" action="@Url.Action("JoinClub", "Club")" 
                                          style="display: inline-block;" class="w-100">
                                        <input type="hidden" name="clubId" value="@club.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success w-100">
                                            <i class="fas fa-plus"></i> Join
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .btn-group.w-100 {
        display: flex;
        width: 100%;
    }

    .btn-group.w-100 .btn {
        flex: 1;
        border-radius: 0;
    }

    .btn-group.w-100 .btn:first-child {
        border-radius: 0.25rem 0 0 0.25rem;
    }

    .btn-group.w-100 .btn:last-child {
        border-radius: 0 0.25rem 0.25rem 0;
    }
</style>
