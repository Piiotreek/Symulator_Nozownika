@model IEnumerable<Symulator_Nozownika.Models.Weapon>

@{
    var favoriteWeaponIds = ViewBag.FavoriteWeaponIds as List<int> ?? new List<int>();
    var favoriteWeapons = Model.Where(w => favoriteWeaponIds.Contains(w.Id)).ToList();
    var regularWeapons = Model.Where(w => !favoriteWeaponIds.Contains(w.Id)).ToList();
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Wybierz swoją broń</h2>

    @if (favoriteWeapons.Any())
    {
        <div class="mb-5">
            <h3 class="mb-3">❤️ Ulubione bronie</h3>
            <hr class="mb-4" />
            <div class="row">
                @foreach (var weapon in favoriteWeapons)
                {
                    <div class="col-md-3 col-sm-6 mb-4">
                        <div class="card weapon-card shadow-sm h-100">
                            <button type="button" 
                                    class="btn btn-link favorite-btn position-absolute top-0 end-0 m-2" 
                                    onclick="toggleFavorite(@weapon.Id, this)"
                                    style="z-index: 10;">
                                <i class="bi bi-heart-fill text-danger" style="font-size: 1.5rem;"></i>
                            </button>
                            <img src="@weapon.ImageUrl" class="card-img-top p-3" alt="@weapon.Name" style="height: 150px; object-fit: contain;" />
                            <div class="card-body text-center">
                                <h5 class="card-title">@weapon.Name</h5>
                                <p class="card-text">
                                    <span class="badge bg-danger">💥 @weapon.Damage DMG</span><br />
                                    <span class="badge bg-info mt-1">⏱️ @weapon.Cooldown.ToString("F1")s CD</span>
                                </p>
                                <form asp-action="SelectWeapon" method="post" class="mt-2">
                                    <input type="hidden" name="weaponId" value="@weapon.Id" />
                                    <button type="submit" class="btn btn-primary btn-sm">Wybierz</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <h3 class="mb-3">Wszystkie bronie</h3>
    <hr class="mb-4" />
    <div class="row">
        @foreach (var weapon in regularWeapons)
        {
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="card weapon-card shadow-sm h-100">
                    <button type="button" 
                            class="btn btn-link favorite-btn position-absolute top-0 end-0 m-2" 
                            onclick="toggleFavorite(@weapon.Id, this)"
                            style="z-index: 10;">
                        <i class="bi bi-heart text-secondary" style="font-size: 1.5rem;"></i>
                    </button>
                    <img src="@weapon.ImageUrl" class="card-img-top p-3" alt="@weapon.Name" style="height: 150px; object-fit: contain;" />
                    <div class="card-body text-center">
                        <h5 class="card-title">@weapon.Name</h5>
                        <p class="card-text">
                            <span class="badge bg-danger">💥 @weapon.Damage DMG</span><br />
                            <span class="badge bg-info mt-1">⏱️ @weapon.Cooldown.ToString("F1")s CD</span>
                        </p>
                        <form asp-action="SelectWeapon" method="post" class="mt-2">
                            <input type="hidden" name="weaponId" value="@weapon.Id" />
                            <button type="submit" class="btn btn-primary btn-sm">Wybierz</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<script>
    function toggleFavorite(weaponId, button) {
        fetch('@Url.Action("ToggleFavorite", "Account")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify({ weaponId: weaponId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Przeładuj stronę aby pokazać zmiany
                location.reload();
            } else {
                alert(data.message || 'Wystąpił błąd');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Wystąpił błąd podczas dodawania do ulubionych');
        });
    }
</script>

<style>
    .weapon-card {
        transition: transform 0.2s;
        position: relative;
    }

    .weapon-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2) !important;
    }

    .favorite-btn {
        text-decoration: none !important;
        padding: 0;
        background: none;
        border: none;
    }

    .favorite-btn:hover i {
        transform: scale(1.2);
        transition: transform 0.2s;
    }
</style>

@Html.AntiForgeryToken()