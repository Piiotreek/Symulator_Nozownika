@model IEnumerable<Symulator_Nozownika.Models.Weapon>
@inject Symulator_Nozownika.Services.ILevelService LevelService

@{
    var userLevel = (int?)ViewBag.UserLevel ?? 1;
    var userTotalScore = (int?)ViewBag.UserTotalScore ?? 0;
    var currentLevelThreshold = (int?)ViewBag.CurrentLevelThreshold ?? 0;
    var nextLevelThreshold = ViewBag.NextLevelThreshold as int?;
    var coinBalance = (int?)ViewBag.CoinBalance ?? 0;
    var purchasedWeaponIds = ViewBag.PurchasedWeaponIds as List<int> ?? new List<int> { Symulator_Nozownika.Services.LevelService.StarterWeaponId };
    var selectedWeaponId = ViewBag.SelectedWeaponId as int?;

    var favoriteWeaponIds = ViewBag.FavoriteWeaponIds as List<int> ?? new List<int>();
    var favoriteWeapons = Model.Where(w => favoriteWeaponIds.Contains(w.Id)).ToList();
    var regularWeapons = Model.Where(w => !favoriteWeaponIds.Contains(w.Id)).ToList();

    var ownedWeapons = regularWeapons.Where(w => purchasedWeaponIds.Contains(w.Id)).ToList();
    var lockedWeapons = regularWeapons.Where(w => userLevel < LevelService.GetRequiredLevelForWeapon(w.Id) || !purchasedWeaponIds.Contains(w.Id)).ToList();
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <h2 class="text-center mb-0">Wybierz swoją broń</h2>
        <a asp-action="Shop" class="btn btn-warning">Przejdź do sklepu</a>
    </div>

    @if (TempData["WeaponSelectError"] is string weaponError && !string.IsNullOrWhiteSpace(weaponError))
    {
        <div class="alert alert-warning text-center" role="alert">@weaponError</div>
    }

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <strong>Level:</strong> @userLevel
                    <span class="text-muted">|</span>
                    <strong>Punkty łącznie:</strong> @userTotalScore
                    <span class="text-muted">|</span>
                    <strong>Monety:</strong> @coinBalance
                </div>

                @if (nextLevelThreshold.HasValue)
                {
                    var span = Math.Max(1, nextLevelThreshold.Value - currentLevelThreshold);
                    var progress = (int)Math.Clamp(((userTotalScore - currentLevelThreshold) * 100.0) / span, 0, 100);
                    <div class="d-flex align-items-center gap-2" style="min-width: 280px;">
                        <small class="text-muted">Do lvl @(userLevel + 1): @(Math.Max(0, nextLevelThreshold.Value - userTotalScore))</small>
                        <div class="progress flex-grow-1" style="height: 10px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @progress%"></div>
                        </div>
                    </div>
                }
                else
                {
                    <span class="badge bg-success">MAKSYMALNY POZIOM</span>
                }
            </div>
        </div>
    </div>

    @if (favoriteWeapons.Any())
    {
        <div class="mb-5">
            <h3 class="mb-3">❤️ Ulubione bronie</h3>
            <hr class="mb-4" />
            <div class="row">
                @foreach (var weapon in favoriteWeapons)
                {
                    var requiredLvl = LevelService.GetRequiredLevelForWeapon(weapon.Id);
                    var isUnlocked = userLevel >= requiredLvl;
                    var isPurchased = purchasedWeaponIds.Contains(weapon.Id);
                    var price = LevelService.GetWeaponPrice(weapon.Id, weapon.Damage);
                    <div class="col-md-3 col-sm-6 mb-4">
                        <div class="card weapon-card shadow-sm h-100 @(isUnlocked ? "" : "weapon-locked")">
                            <button type="button" 
                                    class="btn btn-link favorite-btn position-absolute top-0 end-0 m-2" 
                                    onclick="toggleFavorite(@weapon.Id, this)"
                                    style="z-index: 10;">
                                <i class="bi bi-heart-fill text-danger" style="font-size: 1.5rem;"></i>
                            </button>
                            <img src="@weapon.ImageUrl" class="card-img-top p-3" alt="@weapon.Name" style="height: 150px; object-fit: contain;" />
                            <div class="card-body text-center">
                                <h5 class="card-title">@weapon.Name</h5>
                                <p class="card-text">
                                    <span class="badge bg-danger">💥 @weapon.Damage DMG</span><br />
                                    <span class="badge bg-info mt-1">⏱️ @weapon.Cooldown.ToString("F1")s CD</span>
                                     <br />
                                     <span class="badge bg-warning text-dark mt-1">💰 @price</span>
                                    @if (!isUnlocked)
                                    {
                                        <br />
                                        <span class="badge bg-secondary mt-1">Zablokowana (lvl @requiredLvl)</span>
                                    }
                                     else if (isPurchased)
                                     {
                                         <br />
                                         <span class="badge bg-success mt-1">Kupiona</span>
                                     }
                                </p>
                                <form asp-action="SelectWeapon" method="post" class="mt-2">
                                    <input type="hidden" name="weaponId" value="@weapon.Id" />
                                     <button type="submit" class="btn btn-primary btn-sm" disabled="@(!isUnlocked || !isPurchased)">
                                         @(selectedWeaponId == weapon.Id ? "Wybrana" : "Wybierz")
                                     </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <h3 class="mb-3">Kupione bronie</h3>
    <hr class="mb-4" />
    <div class="row">
        @foreach (var weapon in ownedWeapons)
        {
            var requiredLvl = LevelService.GetRequiredLevelForWeapon(weapon.Id);
            var isUnlocked = userLevel >= requiredLvl;
            var price = LevelService.GetWeaponPrice(weapon.Id, weapon.Damage);
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="card weapon-card shadow-sm h-100 @(isUnlocked ? "" : "weapon-locked")">
                    <button type="button" 
                            class="btn btn-link favorite-btn position-absolute top-0 end-0 m-2" 
                            onclick="toggleFavorite(@weapon.Id, this)"
                            style="z-index: 10;">
                        <i class="bi bi-heart text-secondary" style="font-size: 1.5rem;"></i>
                    </button>
                    <img src="@weapon.ImageUrl" class="card-img-top p-3" alt="@weapon.Name" style="height: 150px; object-fit: contain;" />
                    <div class="card-body text-center">
                        <h5 class="card-title">@weapon.Name</h5>
                        <p class="card-text">
                            <span class="badge bg-danger">💥 @weapon.Damage DMG</span><br />
                            <span class="badge bg-info mt-1">⏱️ @weapon.Cooldown.ToString("F1")s CD</span>
                            <br />
                            <span class="badge bg-warning text-dark mt-1">💰 @price</span>
                            @if (!isUnlocked)
                            {
                                <br />
                                <span class="badge bg-secondary mt-1">Zablokowana (lvl @requiredLvl)</span>
                            }
                            else
                            {
                                <br />
                                <span class="badge bg-success mt-1">Kupiona</span>
                            }
                        </p>
                        <form asp-action="SelectWeapon" method="post" class="mt-2">
                            <input type="hidden" name="weaponId" value="@weapon.Id" />
                            <button type="submit" class="btn btn-primary btn-sm" disabled="@(!isUnlocked)">
                                @(selectedWeaponId == weapon.Id ? "Wybrana" : "Wybierz")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <h3 class="mb-3 mt-4">Niedostępne bronie</h3>
    <hr class="mb-4" />
    <div class="row">
        @foreach (var weapon in lockedWeapons)
        {
            var requiredLvl = LevelService.GetRequiredLevelForWeapon(weapon.Id);
            var price = LevelService.GetWeaponPrice(weapon.Id, weapon.Damage);
            var isPurchased = purchasedWeaponIds.Contains(weapon.Id);
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="card weapon-card shadow-sm h-100 weapon-locked">
                    <img src="@weapon.ImageUrl" class="card-img-top p-3" alt="@weapon.Name" style="height: 150px; object-fit: contain;" />
                    <div class="card-body text-center">
                        <h5 class="card-title">@weapon.Name</h5>
                        <p class="card-text">
                            <span class="badge bg-danger">💥 @weapon.Damage DMG</span><br />
                            <span class="badge bg-info mt-1">⏱️ @weapon.Cooldown.ToString("F1")s CD</span>
                            <br />
                            <span class="badge bg-warning text-dark mt-1">Cena: @price</span>
                            <br />
                            @if (!isPurchased)
                            {
                                <span class="badge bg-secondary mt-1">Kup ją w sklepie</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary mt-1">Zablokowana (lvl @requiredLvl)</span>
                            }
                        </p>
                        <a asp-action="Shop" class="btn btn-outline-warning btn-sm">Otwórz sklep</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<script>
    function toggleFavorite(weaponId, button) {
        fetch('@Url.Action("ToggleFavorite", "Account")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify({ weaponId: weaponId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Przeładuj stronę aby pokazać zmiany
                location.reload();
            } else {
                alert(data.message || 'Wystąpił błąd');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Wystąpił błąd podczas dodawania do ulubionych');
        });
    }
</script>

<style>
    .weapon-card {
        transition: transform 0.2s;
        position: relative;
    }

    .weapon-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2) !important;
    }

    .favorite-btn {
        text-decoration: none !important;
        padding: 0;
        background: none;
        border: none;
    }

    .favorite-btn:hover i {
        transform: scale(1.2);
        transition: transform 0.2s;
    }

    .weapon-locked {
        opacity: 0.55;
    }
</style>

@Html.AntiForgeryToken()