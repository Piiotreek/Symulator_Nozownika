@model Symulator_Nozownika.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Zmień hasło";
}

<div class="container mt-5" style="max-width: 500px;">
    <h2 class="text-center mb-4">Zmień hasło</h2>

    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-4">
            <label class="form-label" asp-for="CurrentPassword">Obecne hasło</label>
            <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label class="form-label" asp-for="NewPassword">Nowe hasło</label>
            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label class="form-label" asp-for="ConfirmPassword">Potwierdź nowe hasło</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100 mb-3">Zapisz nowe hasło</button>
        <a asp-action="SecurePage" class="btn btn-outline-secondary w-100">Anuluj</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}