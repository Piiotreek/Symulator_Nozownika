@model Symulator_Nozownika.Models.UserAccount

@{
    ViewData["Title"] = "Symulator Nożownika - Walka";
    var weaponName = Model.SelectedWeapon?.Name ?? "Pięści";
    var weaponDmg = (int?)ViewBag.EffectiveWeaponDamage ?? Model.SelectedWeapon?.Damage ?? 10;
    var weaponCdValue = (double?)ViewBag.EffectiveWeaponCooldown ?? Model.SelectedWeapon?.Cooldown ?? 1.0;
    var weaponCd = weaponCdValue.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    var weaponImg = Model.SelectedWeapon?.ImageUrl ?? "/images/default.png";
    var coinBalance = Model.CoinWallet?.Balance ?? 0;
    var isDemoUser = Model.IsDemo;
    var damageBonus = (int?)ViewBag.SelectedWeaponDamageBonus ?? 0;
    var cooldownReduction = (double?)ViewBag.SelectedWeaponCooldownReduction ?? 0;
    var selectedWeaponUpgrades = ViewBag.SelectedWeaponUpgrades as IEnumerable<Symulator_Nozownika.Models.WeaponUpgrade> ?? Enumerable.Empty<Symulator_Nozownika.Models.WeaponUpgrade>();
    var availablePotions = ViewBag.AvailablePotions as IEnumerable<Symulator_Nozownika.Models.PurchasedPotion> ?? Enumerable.Empty<Symulator_Nozownika.Models.PurchasedPotion>();
}

<div class="container mt-4">
    @if (isDemoUser)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <strong>🎮 Tryb demo</strong> - Ograniczone funkcje. Zmiana broni oraz dostęp do klubów i rankingów są wyłączone. Maksymalnie 3 gry dziennie.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4 shadow-sm p-3 mb-5 bg-dark rounded text-white border-gold">
        <div class="col-md-4 text-center border-end">
            <h5 class="text-muted">Gracz</h5>
            @{
                var avatarSrc = string.IsNullOrEmpty(Model.AvatarPath) ? "/images/default-avatar.svg" : Model.AvatarPath;
            }
            <img src="@avatarSrc" alt="Awatar" class="rounded-circle mb-2" style="width:80px;height:80px;object-fit:cover;border:2px solid #ffc107;" />
            <h2 class="text-warning">@Model.UserName @(isDemoUser ? "👾" : "")</h2>
            @if (isDemoUser)
            {
                <span class="badge bg-info">DEMO</span>
            }
        </div>
        <div class="col-md-4 text-center">
            <h5 class="text-muted">Wyposażona Broń</h5>
            <div class="d-flex align-items-center justify-content-center">
                <img src="@weaponImg" alt="Weapon" style="height: 50px; margin-right: 15px;" />
                <div>
                    <h4 class="mb-0">@weaponName</h4>
                    <small class="text-info">DMG: @weaponDmg | CD: @weaponCd s</small>
                    @if (damageBonus > 0 || cooldownReduction > 0)
                    {
                        <div class="small text-warning mt-1">Bonusy: +@damageBonus DMG | -@cooldownReduction.ToString("F2") s CD</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4 text-center border-start">
            <div class="stats-bar" style="font-size: 28px; font-weight: bold;">
                <span class="text-danger">HP: <span id="hp-value">10000</span></span>
                <span class="mx-2">|</span>
                <span class="text-clock">Czas: <span id="timer-value">15</span>s</span>
                <div class="mt-2 text-warning" style="font-size: 20px;">Monety: <span id="coin-balance">@coinBalance</span></div>
            </div>
            @if (isDemoUser)
            {
                <small class="text-warning d-block mt-2">Gry: <span id="demo-games">@Model.DemoGamesPlayed</span>/3</small>
            }
        </div>
    </div>

    @if (!isDemoUser)
    {
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="card bg-dark text-white border-gold h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="text-warning mb-3">Aktywne ulepszenia</h5>
                        @if (selectedWeaponUpgrades.Any())
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var upgrade in selectedWeaponUpgrades)
                                {
                                    <div class="upgrade-pill">
                                        <strong>@upgrade.Name</strong>
                                        <span class="text-muted d-block small">+@upgrade.DamageBonus DMG | -@upgrade.CooldownReduction.ToString("F2") s CD</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Brak aktywnych ulepszeń dla aktualnie wybranej broni.</p>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card bg-dark text-white border-gold h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                            <h5 class="text-warning mb-0">Pas potek</h5>
                            <span id="active-potion-status" class="badge bg-secondary">Brak aktywnej potki</span>
                        </div>
                        <div id="potion-effect-visual" class="potion-effect-visual mb-3 d-none"></div>
                        <div id="potion-belt" class="d-flex flex-column gap-2">
                            @if (availablePotions.Any())
                            {
                                @foreach (var potionEntry in availablePotions)
                                {
                                    var potion = potionEntry.Potion;
                                    <button type="button"
                                            class="btn potion-belt-item text-start"
                                            data-potion-id="@potion.Id"
                                            data-effect-strength="@potion.EffectStrength"
                                            data-duration="@potion.DurationInSeconds">
                                        <span class="d-flex justify-content-between align-items-center gap-3">
                                            <span>
                                                <strong>@potion.Name</strong>
                                                <span class="d-block small text-muted">@potion.Description</span>
                                            </span>
                                            <span class="text-end small">
                                                <span class="badge bg-danger-subtle text-warning d-block mb-1">+@potion.EffectStrength%</span>
                                                <span class="badge bg-info-subtle text-info">@potion.DurationInSeconds s</span>
                                            </span>
                                        </span>
                                        <span class="d-block mt-2 small text-light">Sztuk: <span class="potion-quantity">@potionEntry.Quantity</span></span>
                                    </button>
                                }
                            }
                            else
                            {
                                <div class="text-muted">Nie masz żadnych potek. Dokup je w sklepie przed kolejną walką.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8 shadow-lg p-4 bg-light rounded relative-container">
            <div id="cooldown-overlay"></div>

            <div id="round-countdown-overlay" class="round-countdown-overlay d-none">
                <div class="round-countdown-inner">
                    <div class="round-countdown-label">Przygotuj się</div>
                    <div id="round-countdown-value" class="round-countdown-value">3</div>
                    <div class="round-countdown-hint">@(isDemoUser ? "Ustaw celownik" : "Użyj potki i ustaw celownik")</div>
                </div>
            </div>

            <div id="win-overlay" class="round-countdown-overlay d-none" style="z-index: 10;">
                <div class="round-countdown-inner">
                    <div class="round-countdown-value" style="font-size: 5rem;">🏆</div>
                    <div class="round-countdown-label" style="font-size: 3rem; letter-spacing: 0.05rem;">WYGRAŁEŚ!</div>
                </div>
            </div>

            <div id="hit-feedback-layer" class="hit-feedback-layer"></div>

            <div id="graphic-container" class="text-center">
                @await Html.PartialAsync("_HugeGraphic")
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <button id="btn-start" class="btn btn-warning btn-xl shadow">ROZPOCZNIJ SYMULACJĘ</button>
        <div class="mt-3">
            @if (!isDemoUser)
            {
                <a asp-action="SelectWeapon" class="btn btn-outline-secondary btn-sm btn-warning">Zmień broń</a>
               
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="Niedostępne w trybie demo">Zmień broń</button>
                <button type="button" class="btn btn-outline-danger btn-sm ml-2" disabled title="Niedostępne w trybie demo">Usuń konto</button>
                <a href="javascript:history.back()" class="btn btn-outline-info btn-sm ml-2">Wróć</a>
            }
        </div>
    </div>

    @Html.AntiForgeryToken()
    <partial name="_AchievementToast" />
</div>

<!-- Modal: Przypnij wynik -->
<div class="modal fade" id="pinScoreModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">📌 Przypiąć wynik?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Twój wynik: <strong id="pin-score-value"></strong></p>
                <label for="pin-note" class="form-label">Notatka (opcjonalnie):</label>
                <input type="text" id="pin-note" class="form-control" maxlength="100" placeholder="np. rekord z kataną" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Pomiń</button>
                <button type="button" class="btn btn-warning" onclick="confirmPin()">📌 Przypnij</button>
            </div>
        </div>
    </div>
</div>

<script>
    const isDemoUser = @(isDemoUser.ToString().ToLower());

    // Dane z C# przelane do JS
    const weaponDamageBase = @weaponDmg;
    const cooldownTimeBase = @weaponCd * 1000; // zamiana na milisekundy

    let hp = 10000;
    let timeLeft = 15;
    let currentClicks = 0;
    let gameActive = false;
    let canAttack = true;
    let timerInterval;
    let countdownInterval;
    let activePotionTimeout;
    let activePotionCooldownMultiplier = 1;
    let activePotionDamageMultiplier = 1;
    let countdownActive = false;
    let pendingRoundStart = false;
    let criticalHitChance = 0;
    let bleedTickDamage = 0;
    let bleedInterval;
    let freezeRoundsUntil = 0;

    const hpDisplay = document.getElementById('hp-value');
    const timerDisplay = document.getElementById('timer-value');
    const startBtn = document.getElementById('btn-start');
    const cooldownOverlay = document.getElementById('cooldown-overlay');
    const activePotionStatus = document.getElementById('active-potion-status');
    const roundCountdownOverlay = document.getElementById('round-countdown-overlay');
    const roundCountdownValue = document.getElementById('round-countdown-value');
    const potionEffectVisual = document.getElementById('potion-effect-visual');
    const winOverlay = document.getElementById('win-overlay');

    // Initialize demo games display if demo user
    if (isDemoUser) {
        fetch('/Demo/GetStatus')
            .then(r => r.json())
            .then(data => {
                const demoGamesEl = document.getElementById('demo-games');
                if (demoGamesEl) {
                    demoGamesEl.textContent = data.gamesPlayed;
                }
            })
            .catch(err => console.error('Error loading demo status:', err));
    }

    const multipliers = {
        "pecherz": 1.2, "miednica": 1.1, "jelito_grube": 1.5, "jelito_cienkie": 1.4,
        "serce": 5.0, "cialo": 1.0, "watroba": 2.0, "zoladek": 1.8,
        "tchawica": 2.5, "kosci": 0.8, "pluca": 2.2, "default": 1.0
    };

    function getCurrentCooldownTime() {
        return Math.max(50, Math.round(cooldownTimeBase * activePotionCooldownMultiplier));
    }

    function activatePotionEffects(potionName, effectStrength, durationInSeconds) {
        clearTimeout(activePotionTimeout);

        activePotionDamageMultiplier = 1;
        activePotionCooldownMultiplier = 1;
        criticalHitChance = 0;
        bleedTickDamage = 0;

        switch (potionName) {
            case 'Adrenalina':
                activePotionCooldownMultiplier = Math.max(0.45, 1 - (Math.max(0, effectStrength) / 100));
                break;
            case 'Furia':
                activePotionDamageMultiplier = 1 + (Math.max(0, effectStrength) / 100);
                criticalHitChance = 0.14;
                break;
            case 'Krwawiące Ostrze':
                bleedTickDamage = Math.max(1, effectStrength);
                break;
            case 'Stop-Czas':
                freezeRoundsUntil = Date.now() + (durationInSeconds * 1000);
                break;
            default:
                activePotionDamageMultiplier = 1 + (Math.max(0, effectStrength) / 100);
                activePotionCooldownMultiplier = Math.max(0.45, 1 - ((Math.max(0, effectStrength) / 100) * 0.65));
                break;
        }

        if (activePotionStatus) {
            activePotionStatus.className = 'badge bg-warning text-dark';
            activePotionStatus.textContent = `${potionName}: ${getPotionStatusLabel(potionName, effectStrength, durationInSeconds)}`;
        }

        if (potionEffectVisual) {
            potionEffectVisual.className = `potion-effect-visual mb-3 ${getPotionVisualClass(potionName)}`;
            potionEffectVisual.textContent = getPotionVisualText(potionName, effectStrength, durationInSeconds);
        }

        activePotionTimeout = setTimeout(() => {
            activePotionDamageMultiplier = 1;
            activePotionCooldownMultiplier = 1;
            criticalHitChance = 0;
            bleedTickDamage = 0;
            freezeRoundsUntil = 0;
            if (activePotionStatus) {
                activePotionStatus.className = 'badge bg-secondary';
                activePotionStatus.textContent = 'Brak aktywnej potki';
            }
            if (potionEffectVisual) {
                potionEffectVisual.className = 'potion-effect-visual mb-3 d-none';
                potionEffectVisual.textContent = '';
            }
        }, durationInSeconds * 1000);
    }

    function getPotionStatusLabel(potionName, effectStrength, durationInSeconds) {
        switch (potionName) {
            case 'Adrenalina':
                return `-${effectStrength}% cooldownu przez ${durationInSeconds}s`;
            case 'Furia':
                return `+${effectStrength}% mocy i szansa na crit x3 przez ${durationInSeconds}s`;
            case 'Krwawiące Ostrze':
                return `bleed ${effectStrength} dmg/tick przez ${durationInSeconds}s`;
            case 'Stop-Czas':
                return `zatrzymanie czasu na ${durationInSeconds}s`;
            default:
                return `aktywny efekt przez ${durationInSeconds}s`;
        }
    }

    function getPotionVisualClass(potionName) {
        switch (potionName) {
            case 'Adrenalina':
                return 'potion-effect-visual speed';
            case 'Furia':
                return 'potion-effect-visual fury';
            case 'Krwawiące Ostrze':
                return 'potion-effect-visual bleed';
            case 'Stop-Czas':
                return 'potion-effect-visual time-freeze';
            default:
                return 'potion-effect-visual';
        }
    }

    function getPotionVisualText(potionName, effectStrength, durationInSeconds) {
        switch (potionName) {
            case 'Adrenalina':
                return `⚡ Adrenalina aktywna: broń szybsza o ${effectStrength}% przez ${durationInSeconds}s`;
            case 'Furia':
                return `🔥 Furia aktywna: większy dmg i szansa na crit x3 przez ${durationInSeconds}s`;
            case 'Krwawiące Ostrze':
                return `🩸 Bleed aktywny: ${effectStrength} obrażeń na tick przez ${durationInSeconds}s`;
            case 'Stop-Czas':
                return `⏳ Czas zatrzymany na ${durationInSeconds}s - wykorzystaj darmowe trafienia`;
            default:
                return `✨ ${potionName} aktywna przez ${durationInSeconds}s`;
        }
    }

    function triggerBleed() {
        if (bleedTickDamage <= 0) {
            return;
        }

        clearInterval(bleedInterval);
        let remainingTicks = 3;

        bleedInterval = setInterval(() => {
            if (!gameActive || remainingTicks <= 0 || hp <= 0) {
                clearInterval(bleedInterval);
                return;
            }

            hp = Math.max(0, hp - bleedTickDamage);
            hpDisplay.innerText = hp;
            remainingTicks--;

           if (hp <= 0) {
                clearInterval(bleedInterval);
                if (winOverlay) {
                    winOverlay.classList.remove('d-none');
                    setTimeout(() => winOverlay.classList.add('d-none'), 6000);
                }
                endGame('CEL WYKRWAWIŁ SIĘ!');
            }
        }, 1000);
    }

    function isTimeFrozen() {
        return freezeRoundsUntil > Date.now();
    }

    async function usePotion(button) {
        if (!button || (!gameActive && !countdownActive)) {
            return;
        }

        const quantityEl = button.querySelector('.potion-quantity');
        const quantity = parseInt(quantityEl?.textContent || '0', 10);
        if (quantity <= 0) {
            button.disabled = true;
            return;
        }

        button.disabled = true;

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const response = await fetch('@Url.Action("UsePotion", "Account")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    ...(token ? { 'RequestVerificationToken': token } : {})
                },
                body: JSON.stringify({ potionId: parseInt(button.dataset.potionId, 10) })
            });

            const result = await response.json();
            if (!result.success) {
                alert(result.message || 'Nie udało się użyć potki.');
                button.disabled = false;
                return;
            }

            if (quantityEl) {
                quantityEl.textContent = result.remainingQuantity;
            }

            activatePotionEffects(result.potionName, result.effectStrength, result.durationInSeconds);

            if (result.remainingQuantity <= 0) {
                button.classList.add('disabled');
            } else {
                button.disabled = false;
            }
        } catch (error) {
            console.error('Błąd podczas używania potki:', error);
            alert('Nie udało się użyć potki.');
            button.disabled = false;
        }
    }

    function beginRound() {
        gameActive = true;
        pendingRoundStart = false;
        canAttack = true;
        startBtn.style.display = 'none';

        timerInterval = setInterval(() => {
            if (isTimeFrozen()) {
                return;
            }

            timeLeft--;
            timerDisplay.innerText = timeLeft;
            if (timeLeft <= 0) endGame("KONIEC CZASU!");
        }, 1000);
    }

    function startCountdown() {
        countdownActive = true;
        pendingRoundStart = true;
        canAttack = false;

        if (roundCountdownOverlay) {
            roundCountdownOverlay.classList.remove('d-none');
        }

        let countdown = 3;
        if (roundCountdownValue) {
            roundCountdownValue.textContent = countdown;
        }

        clearInterval(countdownInterval);
        countdownInterval = setInterval(() => {
            countdown--;

            if (countdown > 0) {
                if (roundCountdownValue) {
                    roundCountdownValue.textContent = countdown;
                }
                return;
            }

            clearInterval(countdownInterval);
            countdownActive = false;

            if (roundCountdownValue) {
                roundCountdownValue.textContent = 'START';
            }

            setTimeout(() => {
                if (roundCountdownOverlay) {
                    roundCountdownOverlay.classList.add('d-none');
                }
                beginRound();
            }, 350);
        }, 1000);
    }

    function startGame() {
        hp = 10000;
        timeLeft = 15;
        gameActive = false;
        canAttack = false;
        currentClicks = 0;
        activePotionDamageMultiplier = 1;
        activePotionCooldownMultiplier = 1;
        criticalHitChance = 0;
        bleedTickDamage = 0;
        freezeRoundsUntil = 0;
        clearTimeout(activePotionTimeout);
        clearInterval(bleedInterval);
        clearInterval(timerInterval);
        hpDisplay.innerText = hp;
        timerDisplay.innerText = timeLeft;
        startBtn.disabled = true;
        startBtn.innerText = 'PRZYGOTUJ SIĘ';

        if (activePotionStatus) {
            activePotionStatus.className = 'badge bg-secondary';
            activePotionStatus.textContent = 'Brak aktywnej potki';
        }

        if (potionEffectVisual) {
            potionEffectVisual.className = 'potion-effect-visual mb-3 d-none';
            potionEffectVisual.textContent = '';
        }

        startCountdown();
    }

    async function testingsubmitGameScore(finalScore, currentClicks) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const isDemoUser = @(isDemoUser.ToString().ToLower());

        if (isDemoUser) {
            // Submit demo score
            const response = await fetch('/Demo/SaveDemoScore', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    ...(token ? { 'RequestVerificationToken': token } : {})
                },
                body: JSON.stringify({
                    score: finalScore,
                    clicks: currentClicks,
                    playTimeSeconds: 15
                })
            });

            const result = await response.json();
            if (result.success) {
                console.log(`📊 Gra ${result.gamesPlayed} zapisana. Pozostało gier: ${result.gamesRemaining}`);
                updateDemoGamesDisplay(result.gamesPlayed);

                // Jeśli to była ostatnia gra (3. gra)
                if (result.isLastGame) {
                    console.log('🎮 Osiągnięto limit 3 gier! Wylogowuję gracza...');
                    showDemoLimitAlert(result.message);

                } else {
                    // Pokazuj licznik pozostałych gier
                    console.log(`ℹ️ Pozostało gier: ${result.gamesRemaining}`);
                }
            } else {
                alert(result.error || 'Błąd podczas zapisywania wyniku');
            }
        } else {
            // Normal user score submission
           const response = await fetch('/api/gamescore/savescore', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    ...(token ? { 'RequestVerificationToken': token } : {})
                },
                body: JSON.stringify({
                    score: finalScore,
                    clicks: currentClicks,
                    playTimeSeconds: 15,
                    won: hp <= 0
                })
            });

            const result = await response.json();
            console.log('✓ SaveScore response:', result);

            if (result.success) {
                // Show achievements if unlocked
                if (result.achievements && result.achievements.length > 0) {
                    result.achievements.forEach(ach => {
                        let name = ach.name || ach.Name;
                        let imagePath = ach.imagePath || ach.ImagePath;
                        if (typeof showAchievementToast === "function") {
                            showAchievementToast(name, imagePath);
                        }
                    });
                }

                // Show completed quests if any
                if (result.completedQuests && result.completedQuests.length > 0) {
                    result.completedQuests.forEach(q => {
                        if (typeof showQuestCompletedToast === "function") {
                            showQuestCompletedToast(q.name || q.Name, q.rewardCoins || q.RewardCoins, q.rewardXp || q.RewardXp);
                        }
                    });
                }
            } else if (result.expiresAt) {
                window.location.href = '@Url.Action("Suspension", "Account")';
            } else if (result.needsLogin) {
                alert(result.message || 'Zaloguj się, aby zapisać wynik.');
            } else {
                // Ogólny błąd - zawsze załaduj stronę
                console.error('Błąd przy zapisywaniu wyniku:', result);
                location.reload();
            }
        }
    }

    function showDemoLimitAlert(message) {
        gameActive = false;
        startBtn.disabled = true;
        showDemoCountdownOverlay();
    }

    function showDemoCountdownOverlay() {
        const existing = document.getElementById('demo-countdown-overlay');
        if (existing) existing.remove();

        const overlay = document.createElement('div');
        overlay.id = 'demo-countdown-overlay';
        overlay.style.cssText = `
            position: fixed; inset: 0; z-index: 99999;
            background: rgba(0,0,0,0.92);
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            text-align: center; padding: 2rem;
            animation: fadeInOverlay 0.4s ease;
        `;

        overlay.innerHTML = `
            <style>
                @@keyframes fadeInOverlay { from { opacity: 0; } to { opacity: 1; } }
                @@keyframes pulseNumber { 0%,100% { transform: scale(1); } 50% { transform: scale(1.15); } }
                #demo-countdown-number { animation: pulseNumber 1s infinite; }
            </style>
            <div style="font-size: 4rem; margin-bottom: 0.5rem;">🎮</div>
            <h2 style="color: #ff4d4d; font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem;">
                Limit gier demo osiągnięty!
            </h2>
            <p style="color: #ccc; font-size: 1.1rem; max-width: 420px; margin-bottom: 0.25rem;">
                Rozegrałeś 3 gry w trybie demo.
            </p>
            <p style="color: #aaa; font-size: 0.95rem; margin-bottom: 2rem;">
                Spróbuj ponownie za 6 godzin lub <strong style="color:#fff;">zarejestruj się</strong> by grać bez limitu!
            </p>
            <div style="color: #aaa; font-size: 1rem; margin-bottom: 0.5rem;">
                Zostaniesz wylogowany za:
            </div>
            <div id="demo-countdown-number" style="
                font-size: 5rem; font-weight: 900;
                color: #ff4d4d; line-height: 1;
                margin-bottom: 2rem;
            ">5</div>
            <button onclick="redirectToDemoEnd()" style="
                background: #ff4d4d; color: #fff; border: none;
                padding: 0.6rem 1.8rem; border-radius: 6px;
                font-size: 1rem; cursor: pointer; font-weight: 600;
            ">Przejdź teraz →</button>
        `;

        document.body.appendChild(overlay);

        let seconds = 5;
        const numberEl = document.getElementById('demo-countdown-number');
        const interval = setInterval(() => {
            seconds--;
            if (numberEl) numberEl.textContent = seconds;
            if (seconds <= 0) {
                clearInterval(interval);
                redirectToDemoEnd();
            }
        }, 1000);
    }

    function redirectToDemoEnd() {
        console.log('Przekierowuję do strony głównej...');
        window.location.href = '@Url.Action("StartView", "Home")';
    }

    function updateDemoGamesDisplay(gamesPlayed) {
        const demoGamesEl = document.getElementById('demo-games');
        if (demoGamesEl) {
            demoGamesEl.textContent = gamesPlayed;
        }
    }

    function endGame(message) {
        gameActive = false;
        countdownActive = false;
        pendingRoundStart = false;
        clearInterval(timerInterval);
        clearInterval(countdownInterval);
        clearInterval(bleedInterval);
        startBtn.style.display = 'inline-block';
        startBtn.disabled = false;
        startBtn.innerText = "ZAGRAJ PONOWNIE";

        if (roundCountdownOverlay) {
            roundCountdownOverlay.classList.add('d-none');
        }

        if (potionEffectVisual) {
            potionEffectVisual.className = 'potion-effect-visual mb-3 d-none';
            potionEffectVisual.textContent = '';
        }

        const finalScore = 10000 - hp;
        console.log(`🎮 Koniec gry! HP: ${hp}, Wynik: ${finalScore}`);

        setTimeout(() => {
            console.log(`📤 Wysyłam wynik: ${finalScore},${currentClicks}`);
            testingsubmitGameScore(finalScore, currentClicks);

            // Only show pin modal if not demo user
            if (!isDemoUser) {
                showPinModal(finalScore);
            }
        }, 100);
    }

    let _pendingPinScore = 0;
    function showPinModal(score) {
        _pendingPinScore = score;
        document.getElementById('pin-score-value').innerText = score;
        document.getElementById('pin-note').value = '';
        const modal = new bootstrap.Modal(document.getElementById('pinScoreModal'));
        modal.show();
    }

    async function confirmPin() {
        const note = document.getElementById('pin-note').value;
        bootstrap.Modal.getInstance(document.getElementById('pinScoreModal')).hide();

        const response = await fetch('/GameScore/PinScore', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ score: _pendingPinScore, note })
        });
        const result = await response.json();
        // if (result.success) {
        //     console.log('📌 Wynik przypiąty do ulubionych!');
        // }
    }

    function setupOrganListeners() {
        const organs = document.querySelectorAll('.organ');
        console.log(`📍 Znaleziono organów: ${organs.length}`);

        organs.forEach(organ => {
            organ.addEventListener('click', function() {
                if (!gameActive || !canAttack) return;
                //adding clicks
                currentClicks++;
                const organName = this.querySelector('title')?.textContent || "default";
                const multiplier = multipliers[organName] || multipliers["default"];

                // Odejmujemy: (DMG broni * mnożnik organu)
                let totalDamage = Math.round(weaponDamageBase * activePotionDamageMultiplier * multiplier);
                const isCriticalHit = criticalHitChance > 0 && Math.random() < criticalHitChance;
                if (isCriticalHit) {
                    totalDamage *= 3;
                    showCriticalHitFeedback(this, totalDamage);
                }

                hp -= totalDamage;
                if (hp < 0) hp = 0;
                hpDisplay.innerText = hp;

                console.log(`💥 Trafienie! Organ: ${organName}, DMG: ${totalDamage}, HP: ${hp}`);

                // Efekt uderzenia
                this.classList.add('hit');
                setTimeout(() => this.classList.remove('hit'), 150);

                if (bleedTickDamage > 0) {
                    triggerBleed();
                }

               // Logika Cooldownu
                activateCooldown();
                if (hp <= 0 && winOverlay) {
                        winOverlay.classList.remove('d-none');
                        endGame("WYGRAŁEŚ!"); // <--- DODANA LINIJKA: Zatrzymuje grę i wysyła wynik!
                        setTimeout(() => {
                            winOverlay.classList.add('d-none');
                        }, 6000);
                }
            });
        });
    }

    function activateCooldown() {
        canAttack = false;
        cooldownOverlay.style.height = "100%"; // "Zalewa" grafikę
        cooldownOverlay.style.transition = "none";

        // Płynne opadanie nakładki cooldownu
        setTimeout(() => {
            cooldownOverlay.style.transition = `height ${getCurrentCooldownTime()}ms linear`;
            cooldownOverlay.style.height = "0%";
        }, 10);

        setTimeout(() => {
            canAttack = true;
        }, getCurrentCooldownTime());
    }

    function showCriticalHitFeedback(target, damage) {
        const layer = document.getElementById('hit-feedback-layer');
        const rect = target.getBoundingClientRect();
        const containerRect = layer?.getBoundingClientRect();
        if (!layer || !containerRect) {
            return;
        }

        const label = document.createElement('div');
        label.className = 'critical-hit-label';
        label.textContent = `Critical Hit! x3 (${damage})`;
        label.style.left = `${rect.left - containerRect.left + (rect.width / 2)}px`;
        label.style.top = `${rect.top - containerRect.top + (rect.height / 2)}px`;
        layer.appendChild(label);

        document.body.classList.add('critical-hit-shake');
        setTimeout(() => document.body.classList.remove('critical-hit-shake'), 220);
        setTimeout(() => label.remove(), 700);
    }

    startBtn.addEventListener('click', startGame);
    document.querySelectorAll('.potion-belt-item').forEach(button => {
        button.addEventListener('click', () => usePotion(button));
    });

    // Upewnij się, że SVG jest załadowany przed dodaniem event listenerów
    function initializeOrganListeners() {
        console.log(`📍 Inicjalizacja organ listenerów, document.readyState: ${document.readyState}`);
        setupOrganListeners();
    }

    if (document.readyState === 'loading') {
        console.log('📍 DOM nie jest jeszcze gotowy, czekam na DOMContentLoaded');
        document.addEventListener('DOMContentLoaded', initializeOrganListeners);
    } else {
        console.log('📍 DOM jest już gotowy, inicjalizuję od razu');
        initializeOrganListeners();
    }
</script>

<style>
