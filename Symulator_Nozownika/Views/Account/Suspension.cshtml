@{
    ViewData["Title"] = "Konto zawieszone";
    var reason = ViewBag.Reason as string ?? "Naruszenie zasad gry.";
    var expiresAtUtc = (DateTime)ViewBag.ExpiresAtUtc;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-warning shadow">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0">Konto jest czasowo zawieszone</h3>
                </div>
                <div class="card-body text-center">
                    <p class="lead mb-3">Nie możesz teraz uruchomić gry.</p>
                    <p class="text-muted mb-4">@reason</p>

                    <div class="display-5 fw-bold text-danger mb-2" id="suspension-countdown">--:--:--</div>
                    <p class="text-muted">Blokada skończy się: <strong id="suspension-end"></strong></p>

                    <a asp-action="SecurePage" class="btn btn-warning mt-3 d-none" id="return-to-game">Wróć do gry</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary mt-3">Strona główna</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const expiresAt = new Date('@expiresAtUtc.ToString("O")');
    const countdownEl = document.getElementById('suspension-countdown');
    const endEl = document.getElementById('suspension-end');
    const returnBtn = document.getElementById('return-to-game');

    endEl.textContent = expiresAt.toLocaleString('pl-PL');

    function updateCountdown() {
        const remainingMs = expiresAt.getTime() - Date.now();

        if (remainingMs <= 0) {
            countdownEl.textContent = '00:00:00';
            returnBtn.classList.remove('d-none');
            return;
        }

        const totalSeconds = Math.floor(remainingMs / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        const time = [hours, minutes, seconds]
            .map(value => value.toString().padStart(2, '0'))
            .join(':');

        countdownEl.textContent = days > 0 ? `${days}d ${time}` : time;
        setTimeout(updateCountdown, 1000);
    }

    updateCountdown();
</script>
