@model IEnumerable<dynamic>
@using System.Text

@{
    ViewData["Title"] = "Ranking";

    string NormalizeFlag(string? flag)
    {
        if (string.IsNullOrWhiteSpace(flag))
        {
            return "🏳️";
        }

        if (!flag.Contains("ð"))
        {
            return flag;
        }

        var bytes = Encoding.GetEncoding("ISO-8859-1").GetBytes(flag);
        var normalized = Encoding.UTF8.GetString(bytes);
        return string.IsNullOrWhiteSpace(normalized) ? "🏳️" : normalized;
    }
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <h1 class="text-center mb-4">🏆 Ranking</h1>

            @if (Model != null && Model.Any())
            {
                <table class="table table-dark table-striped table-hover">
                    <thead>
                        <tr>
                            <th style="width: 10%;">Place</th>
                            <th style="width: 35%;">Player</th>
                            <th style="width: 20%;">Country</th>
                            <th style="width: 15%;">Score</th>
                            <th style="width: 20%;">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int position = 1;
                            foreach (var score in Model)
                            {
                                var country = (string?)score.Country;
                                var countryFlag = NormalizeFlag((string?)score.CountryFlag);

                                <tr>
                                    <td>
                                        @if (position == 1)
                                        {
                                            <span class="badge bg-warning text-dark">🥇 @position</span>
                                        }
                                        else if (position == 2)
                                        {
                                            <span class="badge bg-secondary">🥈 @position</span>
                                        }
                                        else if (position == 3)
                                        {
                                            <span class="badge bg-danger">🥉 @position</span>
                                        }
                                        else
                                        {
                                            <span>@position</span>
                                        }
                                    </td>
                                    <td>
                                        <strong>@score.PlayerName</strong>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(country))
                                        {
                                            <span style="margin-right:6px;font-family:'Segoe UI Emoji','Apple Color Emoji','Noto Color Emoji',sans-serif;">@countryFlag</span>
                                            <span>@country</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@score.Score pkt</span>
                                    </td>
                                    <td>
                                        @(((DateTime)score.CreatedAt).ToString("dd.MM.yyyy HH:mm:ss"))
                                    </td>
                                </tr>
                                position++;
                            }
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <p>No highscores to display.</p>
                </div>
            }

            <div class="d-flex justify-content-center gap-2 mt-4">
                <a asp-controller="Account" asp-action="SelectWeapon" class="btn btn-warning">Play game</a>
            </div>
        </div>
    </div>
</div>
