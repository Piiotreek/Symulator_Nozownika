@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Ranking Wyników";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="text-center mb-4">🏆 Ranking Wyników</h1>

            @if (Model != null && Model.Any())
            {
                <table class="table table-dark table-striped table-hover">
                    <thead>
                        <tr>
                            <th style="width: 10%;">Miejsce</th>
                            <th style="width: 50%;">Gracz</th>
                            <th style="width: 20%;">Wynik</th>
                            <th style="width: 20%;">Data</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int position = 1;
                            foreach (var score in Model)
                            {
                                <tr>
                                    <td>
                                        @if (position == 1)
                                        {
                                            <span class="badge bg-warning text-dark">🥇 @position</span>
                                        }
                                        else if (position == 2)
                                        {
                                            <span class="badge bg-secondary">🥈 @position</span>
                                        }
                                        else if (position == 3)
                                        {
                                            <span class="badge bg-danger">🥉 @position</span>
                                        }
                                        else
                                        {
                                            <span>@position</span>
                                        }
                                    </td>
                                    <td>
                                        <strong>@score.PlayerName</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@score.Score pkt</span>
                                    </td>
                                    <td>
                                        @((DateTime)score.CreatedAt).ToLocaleDateString("pl-PL")
                                    </td>
                                </tr>
                                position++;
                            }
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <p>Brak wyników do wyświetlenia.</p>
                </div>
            }
        </div>
    </div>
</div>
